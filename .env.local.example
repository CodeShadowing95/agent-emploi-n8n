# Mode local : copier en .env (cp .env.local.example .env), puis remplir.

# Docker Compose lit ces deux lignes : chaque commande "docker compose" utilise
# alors docker-compose.yml PUIS docker-compose.local.yml, sans avoir à les nommer.
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
COMPOSE_PATH_SEPARATOR=:

# Version de n8n, figée volontairement : https://github.com/n8n-io/n8n/releases
N8N_VERSION=X.Y.Z

# Inutilisé en local mais requis par docker-compose.yml : laisser tel quel.
N8N_HOST=localhost

# Mot de passe de la base Postgres : openssl rand -hex 24
POSTGRES_PASSWORD=

# Clé qui chiffre les identifiants dans n8n : openssl rand -hex 32
# À garder : la même clé servira le jour où tu passeras sur un VPS.
N8N_ENCRYPTION_KEY=

# Optionnel : adresse publique d'un tunnel (Cloudflare) pour les boutons Telegram.
# WEBHOOK_URL=https://exemple.trycloudflare.com/
