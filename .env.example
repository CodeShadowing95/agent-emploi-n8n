# Copier en .env sur le serveur (cp .env.example .env), puis remplir.
# Le fichier .env n'est jamais commité.

# Version de n8n, figée volontairement : https://github.com/n8n-io/n8n/releases
N8N_VERSION=X.Y.Z

# Adresse publique de n8n. Sans nom de domaine : n8n.<IP avec des tirets>.sslip.io
N8N_HOST=n8n.mondomaine.fr

# Mot de passe de la base Postgres : openssl rand -hex 24
POSTGRES_PASSWORD=

# Clé qui chiffre les identifiants dans n8n : openssl rand -hex 32
# À sauvegarder dans un gestionnaire de mots de passe. Perdue = identifiants à refaire.
N8N_ENCRYPTION_KEY=
