    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"offres\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"titre\": { \"type\": \"string\" },\n          \"entreprise\": { \"type\": \"string\" },\n          \"lieu\": { \"type\": \"string\" },\n          \"contrat\": { \"type\": \"string\" },\n          \"lien\": { \"type\": \"string\" },\n          \"extrait\": { \"type\": \"string\" }\n        },\n        \"required\": [\"titre\", \"entreprise\", \"lien\"]\n      }\n    }\n  },\n  \"required\": [\"offres\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        576,
        432
      ],
      "id": "e04a9071-382e-4b50-b17d-fd46fcc6eb23",
      "name": "Format (Extraire)"
    },
    {
      "parameters": {
        "jsCode": "const resultat = [];\n\n$input.all().forEach((item, i) => {\n  // Le mail d'où viennent ces offres (même position que la sortie de Claude)\n  const mail = $('Préparer le mail').itemMatching(i).json;\n\n  for (const o of item.json.output?.offres || []) {\n    const lien = String(o.lien || '').trim();\n    resultat.push({\n      json: {\n        source: mail.source,\n        titre: o.titre || '',\n        entreprise: o.entreprise || '',\n        lieu: o.lieu || '',\n        contrat: o.contrat || '',\n        // Garde-fou : un lien absent du mail a été inventé, on le retire\n        lien: lien && mail.contenu.includes(lien) ? lien : '',\n        description: (o.extrait || '').slice(0, 3000),\n      },\n    });\n  }\n});\n\nreturn resultat;"
      },
