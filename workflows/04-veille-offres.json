    {
      "parameters": {
        "jsCode": "return $input.all().map(({ json: o }) => ({\n  json: {\n    source: 'LinkedIn',\n    titre: o.title || '',\n    entreprise: o.companyName || '',\n    lieu: o.location || '',\n    contrat: o.contractType || '',\n    lien: o.url || '',\n    description: (o.description || '').slice(0, 3000),\n  },\n}));"
      },
