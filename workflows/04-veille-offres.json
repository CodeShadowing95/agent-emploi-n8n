      "id": "d37835f3-8ec0-4705-8c13-3e1487ba87e2",
      "name": "France Travail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "// La réponse contient une liste \"resultats\" (absente les jours sans offre) :\n// on la déplie ici, ce qui remplace le nœud Split Out du chapitre 17.\nreturn $input.all().flatMap(({ json }) => (json.resultats || []).map(o => ({\n  json: {\n    source: 'France Travail',\n    titre: o.intitule || '',\n    entreprise: o.entreprise?.nom || '',\n    lieu: o.lieuTravail?.libelle || '',\n    contrat: o.typeContratLibelle || o.typeContrat || '',\n    lien: o.origineOffre?.urlOrigine || `https://candidat.francetravail.fr/offres/recherche/detail/${o.id}`,\n    description: (o.description || '').slice(0, 3000),\n  },\n})));\n"
      },
      "id": "244183c3-731c-44c4-b78f-41653dcdb796",
      "name": "Normaliser France Travail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        420
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {},
      "id": "ca94d436-a798-42d9-8ee7-58b098ef1946",
      "name": "Merge",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "TON_ID_DE_FEUILLE"
