      "id": "101dcbc8-d030-4540-a341-2f63dce45b57",
      "name": "Apify LinkedIn",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all()\n  .filter(({ json: o }) => o.title || o.companyName)\n  .map(({ json: o }) => ({\n    json: {\n      source: 'LinkedIn',\n      titre: o.title || '',\n      entreprise: o.companyName || '',\n      lieu: o.location || '',\n      contrat: o.contractType || '',\n      lien: o.url || '',\n      description: (o.description || '').slice(0, 3000),\n    },\n  }));\n"
      },
      "id": "5976e0d0-c076-4500-80e1-5f1820751a62",
      "name": "Normaliser LinkedIn",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
