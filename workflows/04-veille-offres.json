      "id": "3c9f9440-1ed3-4120-b858-e3687dd849eb",
      "name": "Lire le suivi",
      "executeOnce": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "Vi2zlhyinOU7AEwP",
          "name": "Google Sheets account"
        }
      }
